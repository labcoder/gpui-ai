{
  "name": "gpui-ai",
  "private": true,
  "description": "Task runner for the gpui-ai workspace. Rust does the real work; these scripts are the front door.",
  "scripts": {
    "dev": "cargo run -p gallery",
    "dev:fast": "cargo run -p gallery --profile dev-fast",
    "prod": "cargo run -p gallery --release",
    "test:perf": "cargo run -p gallery --release --features performance --bin gallery-performance",
    "test:catalog": "cargo run -p gallery --release --features performance --bin gallery-catalog-scan",
    "build": "cargo build --workspace --release",
    "build:wasm": "node script/run-bash.mjs crates/gallery-web/scripts/build-wasm.sh --release",
    "build:web": "npm --prefix crates/gallery-web/www run build && npm run build:site",
    "build:site": "npm --prefix site run build",
    "build:docs": "node script/build-docs.mjs",
    "generate": "npm run generate:catalog && npm run generate:themes",
    "generate:catalog": "cargo run -q -p gallery --features export --bin gallery-catalog-export",
    "generate:themes": "node script/generate-themes.mjs",
    "check": "npm run check:format && npm run check:clippy && npm run check:scripts && npm run test && npm run check:docs",
    "check:format": "cargo fmt --all -- --check",
    "check:clippy": "cargo clippy --workspace -- --deny warnings",
    "check:docs": "cargo rustdoc -p gpui-ai --lib -- -D warnings",
    "check:native": "cargo check --workspace",
    "check:scripts": "node script/test-run-bash.mjs && node script/test-release-notes.mjs",
    "release:notes": "node script/release-notes.mjs",
    "check:web": "npm --prefix crates/gallery-web/www test && npm run check:site && npm run check:web:release",
    "check:web:release": "node script/check-web-release.mjs",
    "check:site": "npm --prefix site test",
    "test": "cargo test --workspace",
    "dev:web": "npm --prefix crates/gallery-web/www run dev",
    "report:wasm": "node crates/gallery-web/scripts/report-size.mjs",
    "check:upstream": "node script/run-bash.mjs script/update-upstream.sh --check",
    "update:upstream": "node script/run-bash.mjs script/update-upstream.sh"
  }
}
