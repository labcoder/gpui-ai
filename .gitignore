# OS noise
.DS_Store

# Upstream icon set copied into the web host by copy-icons.mjs
/crates/gallery-web/www/public/

# Vite app dependencies and output under site/
/site/node_modules/
/site/dist-app/
/site/.ssr-*/

# Posters are rendered by a real browser at build time (npm run generate:posters).
# A GPU-drawn WebP is not byte-reproducible, so checking them in would make the
# generated-output check in CI fail on runs that changed nothing.
/site/public/posters/

# Agent skill installers drop shared skills here. Nothing in this repository
# depends on one, and a skill is somebody else's instructions: it does not
# belong in the history of a library that people build against.
.agents/
skills-lock.json
